{
  "name": "@workspace/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "mastra build",
    "check-types": "tsc --noEmit",
    "dev": "mastra dev",
    "format": "prettier --write \"**/*.{ts,md}\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/azure": "^3.0.73",
    "@mastra/core": "^1.42.0",
    "@mastra/editor": "^0.11.2",
    "@mastra/evals": "^1.3.0",
    "@mastra/observability": "^1.14.1",
    "@t3-oss/env-core": "catalog:",
    "dotenv": "^17.4.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "mastra": "^1.13.0",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./agents": "./src/mastra/agents/index.ts",
    "./agents/*": "./src/mastra/agents/*/index.ts",
    "./evals": "./src/mastra/evals/index.ts",
    "./evals/datasets": "./src/mastra/evals/datasets/index.ts",
    "./evals/experiments": "./src/mastra/evals/experiments/index.ts",
    "./mastra": "./src/mastra/index.ts",
    "./models": "./src/mastra/models/index.ts",
    "./scorers": "./src/mastra/scorers/index.ts",
    "./tools": "./src/mastra/tools/index.ts",
    "./tools/*": "./src/mastra/tools/*/index.ts",
    "./workflows": "./src/mastra/workflows/index.ts",
    "./workflows/*": "./src/mastra/workflows/*/index.ts"
  }
}
