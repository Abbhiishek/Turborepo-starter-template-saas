# Better Auth secrets, sessions, feature flags, and auth provider credentials.
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"

# Optional auth feature flags for the default @workspace/auth/server export.
# Individual apps can also call createAuth({ features: ... }) directly.
AUTH_FEATURES="admin,organization"
AUTH_ADMIN_USER_IDS=""
AUTH_ADMIN_ROLES="admin"
AUTH_ORGANIZATION_TEAMS_ENABLED="true"
AUTH_OPENAPI_ENABLED=""

# Optional social providers.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
