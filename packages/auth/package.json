{
  "name": "@workspace/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:generate": "better-auth generate --config src/schema.ts --output ../db/src/schema/auth.ts --yes",
    "auth:info": "better-auth info --config src/schema.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "better-auth": "^1.6.16",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@types/node": "^20",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./next": "./src/next.ts",
    "./schema": "./src/schema.ts",
    "./server": "./src/server.ts"
  }
}
