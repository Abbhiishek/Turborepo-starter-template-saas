{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", ".mastra/**"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/packages/auth/.env*",
        "$TURBO_ROOT$/packages/db/.env*"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": ["BETTER_AUTH_URL", "NEXT_PUBLIC_APP_URL"],
      "passThroughEnv": [
        "AUTH_*",
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET"
      ]
    },
    "@workspace/ai#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".mastra/**"],
      "env": [
        "AZURE_OPENAI_API_VERSION",
        "AZURE_OPENAI_BASE_URL",
        "AZURE_OPENAI_GPT4O_DEPLOYMENT_NAME",
        "AZURE_OPENAI_GPT5_DEPLOYMENT_NAME",
        "AZURE_OPENAI_OPUS_4_5_DEPLOYMENT_NAME",
        "AZURE_OPENAI_RESOURCE_NAME",
        "AZURE_OPENAI_TEXT_EMBEDDING_DEPLOYMENT_NAME",
        "AZURE_OPENAI_USE_DEPLOYMENT_BASED_URLS",
        "AZURE_OPENAI_WEATHER_ITINERARY_DEPLOYMENT_NAME"
      ],
      "passThroughEnv": ["AZURE_OPENAI_API_KEY", "AZURE_OPENAI_HEADERS"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "web#lint": {
      "dependsOn": ["^lint"],
      "env": ["BETTER_AUTH_URL", "NEXT_PUBLIC_APP_URL"],
      "passThroughEnv": [
        "AUTH_*",
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET"
      ]
    },
    "@workspace/ai#lint": {
      "dependsOn": ["^lint"],
      "env": ["AZURE_OPENAI_*"],
      "passThroughEnv": []
    },
    "@workspace/auth#lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/packages/db/.env*"],
      "passThroughEnv": [
        "AUTH_*",
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET"
      ]
    },
    "@workspace/db#lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "web#check-types": {
      "dependsOn": ["^check-types"],
      "env": ["BETTER_AUTH_URL", "NEXT_PUBLIC_APP_URL"],
      "passThroughEnv": [
        "AUTH_*",
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET"
      ]
    },
    "@workspace/ai#check-types": {
      "dependsOn": ["^check-types"],
      "env": ["AZURE_OPENAI_*"],
      "passThroughEnv": []
    },
    "@workspace/auth#check-types": {
      "dependsOn": ["^check-types"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/packages/db/.env*"],
      "passThroughEnv": [
        "AUTH_*",
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET"
      ]
    },
    "@workspace/db#check-types": {
      "dependsOn": ["^check-types"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "web#dev": {
      "cache": false,
      "persistent": true,
      "env": ["BETTER_AUTH_URL", "NEXT_PUBLIC_APP_URL"],
      "passThroughEnv": [
        "AUTH_*",
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET"
      ]
    },
    "@workspace/ai#dev": {
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "AZURE_OPENAI_API_VERSION",
        "AZURE_OPENAI_BASE_URL",
        "AZURE_OPENAI_GPT4O_DEPLOYMENT_NAME",
        "AZURE_OPENAI_GPT5_DEPLOYMENT_NAME",
        "AZURE_OPENAI_OPUS_4_5_DEPLOYMENT_NAME",
        "AZURE_OPENAI_RESOURCE_NAME",
        "AZURE_OPENAI_TEXT_EMBEDDING_DEPLOYMENT_NAME",
        "AZURE_OPENAI_USE_DEPLOYMENT_BASED_URLS",
        "AZURE_OPENAI_WEATHER_ITINERARY_DEPLOYMENT_NAME"
      ],
      "passThroughEnv": ["AZURE_OPENAI_API_KEY", "AZURE_OPENAI_HEADERS"]
    },
    "@workspace/auth#auth:generate": {
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/packages/db/.env*"],
      "passThroughEnv": [
        "AUTH_*",
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET"
      ]
    },
    "@workspace/auth#auth:info": {
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/packages/db/.env*"],
      "passThroughEnv": [
        "AUTH_*",
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET"
      ]
    },
    "@workspace/db#db:generate": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "@workspace/db#db:migrate": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "@workspace/db#db:studio": {
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "passThroughEnv": ["DATABASE_URL"]
    }
  }
}
