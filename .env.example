DATABASE_URL="postgres://user:password@localhost:5432/app"

# Mastra / AI
# Optional. When unset, @workspace/ai falls back to DATABASE_URL for Mastra storage.
AI_DATABASE_URL=""

# Azure OpenAI / Azure AI Foundry model deployments.
AZURE_OPENAI_RESOURCE_NAME=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_API_VERSION=""
AZURE_OPENAI_BASE_URL=""
AZURE_OPENAI_GPT4O_DEPLOYMENT_NAME=""
AZURE_OPENAI_GPT5_DEPLOYMENT_NAME=""
AZURE_OPENAI_OPUS_4_5_DEPLOYMENT_NAME=""
AZURE_OPENAI_WEATHER_ITINERARY_DEPLOYMENT_NAME=""
AZURE_OPENAI_TEXT_EMBEDDING_DEPLOYMENT_NAME="text-embedding-3-small"
AZURE_OPENAI_HEADERS=""
AZURE_OPENAI_USE_DEPLOYMENT_BASED_URLS="false"

# Better Auth
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional auth feature flags for the default @workspace/auth/server export.
# Individual apps can also call createAuth({ features: ... }) directly.
AUTH_FEATURES="admin,organization"
AUTH_ADMIN_USER_IDS=""
AUTH_ADMIN_ROLES="admin"
AUTH_ORGANIZATION_TEAMS_ENABLED="true"

# Optional social providers.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
